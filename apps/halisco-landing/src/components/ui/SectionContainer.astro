---
interface Props {
  id?: string;
  "aria-labelledby"?: string;
  class?: string;
  innerClass?: string;
}

const {
  id,
  "aria-labelledby": ariaLabelledBy,
  class: outerClass,
  innerClass,
} = Astro.props;
---

<section
  id={id}
  aria-labelledby={ariaLabelledBy}
  class:list={["relative", outerClass]}
>
  <slot name="background" />
  <div class:list={["mx-auto w-full max-w-7xl px-8", innerClass]}>
    <slot />
  </div>
</section>
