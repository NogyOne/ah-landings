---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface LightboxImage {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  images: readonly LightboxImage[];
  id?: string;
}

const { images, id = "image-lightbox" } = Astro.props;
---

<dialog
  id={id}
  data-image-lightbox
  aria-label="Vista ampliada de la galería"
  class="m-0 h-dvh max-h-none w-full max-w-none select-none overflow-hidden border-0 bg-transparent p-4 text-theme-foreground backdrop:bg-transparent md:p-8"
>
  <div
    data-lightbox-backdrop
    class="absolute inset-0 bg-theme-background/95 opacity-0"
    aria-hidden="true"
  ></div>

  <div
    data-lightbox-panel
    class="relative z-10 mx-auto flex h-full w-full max-w-6xl flex-col items-center gap-4"
  >
    <div class="flex w-full justify-end">
      <button
        type="button"
        data-lightbox-close
        class="inline-flex h-11 w-11 cursor-pointer items-center justify-center text-theme-foreground transition-colors duration-300 hover:text-theme-accent"
        aria-label="Cerrar imagen"
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div
      class="relative flex min-h-0 w-full flex-1 items-center justify-center"
    >
      <button
        type="button"
        data-lightbox-previous
        class="absolute left-0 z-10 inline-flex h-11 w-11 cursor-pointer items-center justify-center text-theme-foreground transition-colors duration-300 hover:text-theme-accent"
        aria-label="Imagen anterior"
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m15 18-6-6 6-6"></path>
        </svg>
      </button>

      <div
        data-lightbox-stage
        class="flex h-full min-h-0 w-full items-center justify-center px-12 md:px-20"
      >
        {
          images.map((item, index) => (
            <div
              data-lightbox-image
              data-lightbox-target-id={index}
              data-index={index}
              class="aspect-4/5 w-full max-w-[calc(80dvh-8rem)] overflow-hidden"
              hidden={index !== 0}
            >
              <Image
                src={item.image}
                alt={item.alt}
                width={item.image.width}
                height={item.image.height}
                quality={90}
                fit="inside"
                loading="lazy"
                draggable="false"
                class="h-full w-full object-cover object-center"
              />
            </div>
          ))
        }
      </div>

      <button
        type="button"
        data-lightbox-next
        class="absolute right-0 z-10 inline-flex h-11 w-11 cursor-pointer items-center justify-center text-theme-foreground transition-colors duration-300 hover:text-theme-accent"
        aria-label="Imagen siguiente"
      >
        <svg
          viewBox="0 0 24 24"
          width="24"
          height="24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </button>
    </div>

    <p
      data-lightbox-position
      class="m-0 font-body text-xs tracking-[0.18em] text-theme-muted"
      aria-live="polite"
    >
      1 / {images.length}
    </p>
  </div>
</dialog>

<script>
  import { gsap } from "gsap";
  import { Flip } from "gsap/Flip";

  gsap.registerPlugin(Flip);

  interface LightboxOpenDetail {
    index: number;
  }

  const isLightboxOpenDetail = (
    value: unknown,
  ): value is LightboxOpenDetail => {
    if (typeof value !== "object" || value === null || !("index" in value)) {
      return false;
    }

    const index = value.index;
    return typeof index === "number" && Number.isInteger(index);
  };

  const initLightboxes = (): void => {
    document
      .querySelectorAll<HTMLDialogElement>("[data-image-lightbox]")
      .forEach((dialog) => {
        if (dialog.dataset.imageLightboxInitialized === "true") {
          return;
        }

        const backdrop = dialog.querySelector<HTMLElement>(
          "[data-lightbox-backdrop]",
        );
        const closeButton = dialog.querySelector<HTMLButtonElement>(
          "[data-lightbox-close]",
        );
        const previousButton = dialog.querySelector<HTMLButtonElement>(
          "[data-lightbox-previous]",
        );
        const nextButton = dialog.querySelector<HTMLButtonElement>(
          "[data-lightbox-next]",
        );
        const position = dialog.querySelector<HTMLElement>(
          "[data-lightbox-position]",
        );
        const stage = dialog.querySelector<HTMLElement>(
          "[data-lightbox-stage]",
        );
        const slides = Array.from(
          dialog.querySelectorAll<HTMLElement>("[data-lightbox-image]"),
        );

        if (
          !backdrop ||
          !closeButton ||
          !previousButton ||
          !nextButton ||
          !position ||
          !stage ||
          slides.length === 0
        ) {
          return;
        }

        dialog.dataset.imageLightboxInitialized = "true";
        let activeIndex = 0;
        let restoreTarget: HTMLElement | null = null;
        let activeTransition: gsap.core.Timeline | null = null;
        let activeSource: HTMLElement | null = null;

        const galleryRoot = dialog.closest<HTMLElement>("[data-work-gallery]");
        const carouselViewport = galleryRoot?.querySelector<HTMLElement>(
          "[data-carousel-viewport]",
        ) ?? null;

        const prefersReducedMotion = (): boolean =>
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const getSourceFrame = (index: number): HTMLElement | null => {
          const sourceImage = carouselViewport?.querySelector<HTMLImageElement>(
            `[data-flip-id="${index}"]`,
          );

          return sourceImage?.parentElement ?? null;
        };

        const getTargetFrame = (index: number): HTMLElement | null =>
          slides[index]?.matches(`[data-lightbox-target-id="${index}"]`)
            ? slides[index]
            : null;

        const restoreActiveSource = (): void => {
          if (activeSource) {
            gsap.set(activeSource, { clearProps: "visibility" });
            activeSource = null;
          }
        };

        const clearFlipStyles = (target: HTMLElement): void => {
          gsap.set(target, {
            clearProps:
              "transform,transformOrigin,position,top,left,width,height,maxWidth,maxHeight,opacity,visibility,zIndex",
          });
        };

        const settleActiveTransition = (): void => {
          if (!activeTransition) {
            return;
          }

          const transition = activeTransition;
          activeTransition = null;
          transition.progress(1);
          transition.kill();
        };

        const normalizeIndex = (index: number): number =>
          (index + slides.length) % slides.length;

        const setActiveIndex = (index: number): void => {
          activeIndex = normalizeIndex(index);

          slides.forEach((slide, slideIndex) => {
            slide.hidden = slideIndex !== activeIndex;
          });

          position.textContent = `${activeIndex + 1} / ${slides.length}`;
        };

        const restoreFocus = (): void => {
          const target = restoreTarget;
          restoreTarget = null;

          if (target?.isConnected) {
            target.focus({ preventScroll: true });
          }
        };

        const finalizeClose = (): void => {
          closeButton.removeAttribute("data-initial-pointer-focus");
          restoreActiveSource();
          gsap.set(backdrop, { autoAlpha: 0 });

          if (dialog.open) {
            dialog.close();
            return;
          }

          restoreFocus();
        };

        const close = (): void => {
          if (!dialog.open) {
            closeButton.removeAttribute("data-initial-pointer-focus");
            restoreFocus();
            return;
          }

          settleActiveTransition();

          if (!dialog.open) {
            restoreFocus();
            return;
          }

          const reduceMotion = prefersReducedMotion();
          const sourceFrame = reduceMotion ? null : getSourceFrame(activeIndex);
          const targetFrame = getTargetFrame(activeIndex);

          if (reduceMotion || !sourceFrame || !targetFrame) {
            finalizeClose();
            return;
          }

          try {
            clearFlipStyles(targetFrame);
            const expandedState = Flip.getState(targetFrame);
            Flip.fit(targetFrame, sourceFrame, {
              absolute: true,
              scale: true,
            });

            activeSource = sourceFrame;
            gsap.set(sourceFrame, { visibility: "hidden" });

            const transition = gsap.timeline({
              onComplete: () => {
                clearFlipStyles(targetFrame);
                restoreActiveSource();
                activeTransition = null;
                finalizeClose();
              },
            });

            activeTransition = transition;
            transition.add(
              Flip.from(expandedState, {
                targets: targetFrame,
                duration: 0.45,
                ease: "power3.inOut",
                absolute: true,
                scale: true,
              }),
              0,
            );
            transition.to(
              backdrop,
              { autoAlpha: 0, duration: 0.3, ease: "power1.in" },
              0.05,
            );
          } catch {
            activeTransition = null;
            clearFlipStyles(targetFrame);
            restoreActiveSource();
            finalizeClose();
          }
        };

        const open = (index: number): void => {
          restoreTarget =
            document.activeElement instanceof HTMLElement
              ? document.activeElement
              : null;
          settleActiveTransition();

          const reduceMotion = prefersReducedMotion();
          const sourceFrame = reduceMotion ? null : getSourceFrame(index);
          const showFocusRing = restoreTarget?.matches(":focus-visible") === true;

          setActiveIndex(index);
          closeButton.toggleAttribute("data-initial-pointer-focus", !showFocusRing);

          if (!dialog.open) {
            dialog.showModal();
          }

          closeButton.focus({ preventScroll: true });

          const targetFrame = getTargetFrame(index);

          if (!targetFrame) {
            gsap.set(backdrop, { autoAlpha: 1 });
            return;
          }

          if (reduceMotion) {
            gsap.set(backdrop, { autoAlpha: 1 });
            return;
          }

          if (!sourceFrame) {
            gsap.set(backdrop, { autoAlpha: 1 });
            return;
          }

          try {
            clearFlipStyles(targetFrame);
            Flip.fit(targetFrame, sourceFrame, {
              absolute: true,
              scale: true,
            });
            const collapsedState = Flip.getState(targetFrame);
            clearFlipStyles(targetFrame);

            activeSource = sourceFrame;
            gsap.set(sourceFrame, { visibility: "hidden" });

            const transition = gsap.timeline({
              onComplete: () => {
                clearFlipStyles(targetFrame);
                restoreActiveSource();
                activeTransition = null;
              },
            });

            activeTransition = transition;
            transition.add(
              Flip.from(collapsedState, {
                targets: targetFrame,
                duration: 0.55,
                ease: "power2.inOut",
                absolute: true,
                scale: true,
              }),
              0,
            );
            transition.to(
              backdrop,
              { autoAlpha: 1, duration: 0.35, ease: "power1.out" },
              0.08,
            );
          } catch {
            activeTransition = null;
            clearFlipStyles(targetFrame);
            restoreActiveSource();
            gsap.set(backdrop, { autoAlpha: 1 });
          }
        };

        const handleOpen = (event: Event): void => {
          const detail = (event as CustomEvent<unknown>).detail;

          if (isLightboxOpenDetail(detail)) {
            open(detail.index);
          }
        };

        const handlePrevious = (): void => {
          settleActiveTransition();
          setActiveIndex(activeIndex - 1);
        };

        const handleNext = (): void => {
          settleActiveTransition();
          setActiveIndex(activeIndex + 1);
        };

        const handleKeydown = (event: KeyboardEvent): void => {
          closeButton.removeAttribute("data-initial-pointer-focus");
          if (!dialog.open) {
            return;
          }

          if (event.key === "ArrowLeft") {
            event.preventDefault();
            handlePrevious();
          }

          if (event.key === "ArrowRight") {
            event.preventDefault();
            handleNext();
          }
        };

        const handleCancel = (event: Event): void => {
          event.preventDefault();
          close();
        };

        const handleClose = (): void => {
          closeButton.removeAttribute("data-initial-pointer-focus");
          restoreFocus();
        };

        const handleBackdropClick = (event: MouseEvent): void => {
          if (event.target === backdrop) {
            close();
          }
        };

        const handleDialogClick = (event: MouseEvent): void => {
          if (event.target === dialog) {
            close();
          }
        };

        const handleStageClick = (event: MouseEvent): void => {
          const target = event.target;

          if (
            target === stage ||
            (target instanceof HTMLElement &&
              target.matches("[data-lightbox-image]"))
          ) {
            close();
          }
        };

        const cleanup = (): void => {
          if (activeTransition) {
            activeTransition.kill();
            activeTransition = null;
          }

          restoreActiveSource();
          closeButton.removeAttribute("data-initial-pointer-focus");
          slides.forEach((slide) => {
            const image = slide.querySelector<HTMLElement>(
              "[data-lightbox-target-id]",
            );

            if (image) {
              clearFlipStyles(image);
            }
          });
          gsap.set(backdrop, { clearProps: "opacity,visibility" });

          if (dialog.open) {
            dialog.close();
          }

          dialog.removeEventListener("image-lightbox:open", handleOpen);
          closeButton.removeEventListener("click", close);
          previousButton.removeEventListener("click", handlePrevious);
          nextButton.removeEventListener("click", handleNext);
          dialog.removeEventListener("keydown", handleKeydown);
          dialog.removeEventListener("cancel", handleCancel);
          dialog.removeEventListener("close", handleClose);
          backdrop.removeEventListener("click", handleBackdropClick);
          dialog.removeEventListener("click", handleDialogClick);
          stage.removeEventListener("click", handleStageClick);
          document.removeEventListener("astro:before-swap", cleanup);
          dialog.dataset.imageLightboxInitialized = "false";
        };

        dialog.addEventListener("image-lightbox:open", handleOpen);
        closeButton.addEventListener("click", close);
        previousButton.addEventListener("click", handlePrevious);
        nextButton.addEventListener("click", handleNext);
        dialog.addEventListener("keydown", handleKeydown);
        dialog.addEventListener("cancel", handleCancel);
        dialog.addEventListener("close", handleClose);
        backdrop.addEventListener("click", handleBackdropClick);
        dialog.addEventListener("click", handleDialogClick);
        stage.addEventListener("click", handleStageClick);
        document.addEventListener("astro:before-swap", cleanup, { once: true });

        setActiveIndex(0);
      });
  };

  initLightboxes();
</script>

<style>
  [data-lightbox-close][data-initial-pointer-focus]:focus-visible {
    outline: none;
  }
</style>
