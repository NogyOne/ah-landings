---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  index: number;
}

const { image, alt, index } = Astro.props;
---

<li
  data-carousel-slide-item
  data-index={index}
  class="w-[min(82vw,20rem)] shrink-0 snap-start lg:w-85"
>
  <article class="w-full transition-transform duration-300 ease-out hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
    <button
      type="button"
      data-carousel-slide
      data-index={index}
      class="group block w-full border border-[#554D46] bg-[#1B1A18] p-2 text-left transition-colors duration-300 hover:border-theme-accent cursor-pointer"
      aria-haspopup="dialog"
      aria-label={`Ampliar imagen: ${alt}`}
    >
      <span class="block aspect-4/5 w-full overflow-hidden">
        <Image
          src={image}
          alt={alt}
          width={560}
          height={700}
          densities={[1, 2]}
          quality={84}
          fit="cover"
          position="center"
          loading="lazy"
          class="h-full w-full object-cover object-center"
        />
      </span>
    </button>
    <span class="mt-4 block h-px w-10 bg-theme-accent" aria-hidden="true"
    ></span>
  </article>
</li>
