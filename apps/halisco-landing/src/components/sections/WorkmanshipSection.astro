---
import { Image } from "astro:assets";
import liquidGold from "@assets/images/workmanship/liquid-gold.webp";
import meltingGold from "@assets/images/workmanship/melting-gold.webp";
import polish from "@assets/images/workmanship/polish.webp";
import SectionContainer from "@ui/SectionContainer.astro";

const processSteps = [
  {
    title: "Fundición",
    description:
      "El metal es preparado para fundirlo a altas temperaturas hasta que alcanza la temperatura necesaria para comenzar a darle forma.",
    image: liquidGold,
    alt: "Oro fundido brillando dentro de un recipiente de trabajo.",
    width: 600,
    height: 400,
  },
  {
    title: "Forja y soldadura",
    description:
      "Una vez el metal está listo, se trabaja para darle forma según la pieza deseada. Se soldan partes y se ajusta el diseño.",
    image: meltingGold,
    alt: "Metal dorado calentándose durante un proceso de trabajo artesanal.",
    width: 600,
    height: 400,
  },
  {
    title: "Pulido final",
    description:
      "Una vez la pieza está lista, se le dan sus últimos detalles para un acabado de alta calidad y brillo. Se revisa que cumpla con los estándares de la casa.",
    image: polish,
    alt: "Manos puliendo una pieza de joyería dorada con una herramienta de taller.",
    width: 600,
    height: 400,
  },
] as const;
---

<SectionContainer
  id="hechuras"
  aria-labelledby="hechuras-title"
  class="overflow-hidden bg-theme-surface py-20 lg:py-24"
>
  <div
    class="grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-16 lg:gap-y-20"
  >
    <header class="col-span-1 lg:col-span-7">
      <p
        class="mb-4 font-body text-xs font-light tracking-[4px] text-theme-accent"
      >
        HECHURAS
      </p>
      <h2
        id="hechuras-title"
        class="m-0 max-w-3xl font-display text-[34px] font-medium leading-[1.08] tracking-tight text-theme-foreground lg:text-5xl"
      >
        Transformamos tu oro en una pieza hecha para ti.
      </h2>
    </header>

    <div class="col-span-1 lg:col-span-5 lg:pt-8">
      <p
        class="m-0 max-w-xl font-body text-base font-normal leading-[1.6] text-theme-muted"
      >
        Partimos de un diseño de la casa, una pieza ya realizada, una variante o
        una referencia. Primero evaluamos material, medidas y viabilidad.
      </p>
    </div>

    <ol
      class="col-span-1 m-0 grid list-none grid-cols-1 gap-y-14 p-0 lg:col-span-12 lg:grid-cols-3 lg:gap-x-16"
    >
      {
        processSteps.map((step) => (
          <li class="min-w-0">
            <article class="flex h-full flex-col transition-transform duration-300 ease-out hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
              <figure class="m-0">
                <div class="aspect-8/5 w-full overflow-hidden">
                  <Image
                    src={step.image}
                    alt={step.alt}
                    width={step.width}
                    height={step.height}
                    densities={[1, 2]}
                    quality={100}
                    fit="cover"
                    position="center"
                    class="h-full w-full object-cover object-center"
                  />
                </div>
                <figcaption class="mt-6 border-t border-theme-divider/55 pt-5">
                  <h3 class="m-0 font-display text-2xl font-medium text-theme-foreground lg:text-3xl">
                    {step.title}
                  </h3>
                  <p class="m-0 mt-3  font-body text-sm font-normal text-theme-muted">
                    {step.description}
                  </p>
                </figcaption>
              </figure>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</SectionContainer>
