---
import { Image } from "astro:assets";
import jewelryChainMain from "@assets/images/jewelry-chain-main.webp";
import jewelryProducts from "@assets/images/jewelry-products.webp";
import jewelryModel from "@assets/images/jewelry-model.webp";
import SectionContainer from "@ui/SectionContainer.astro";
---

<SectionContainer
  id="jewelry"
  aria-labelledby="jewelry-title"
  class="isolate overflow-hidden bg-theme-surface py-20 lg:py-24"
>
  <div
    slot="background"
    class="pointer-events-none absolute inset-x-0 inset-y-0 z-0 w-full bg-[linear-gradient(to_right,color-mix(in_srgb,var(--color-theme-divider)_16%,transparent)_1px,transparent_1px),linear-gradient(to_bottom,color-mix(in_srgb,var(--color-theme-divider)_16%,transparent)_1px,transparent_1px)] bg-size-[3rem_2rem] mask-[radial-gradient(ellipse_90%_72%_at_50%_50%,black_28%,transparent_100%)] [-webkit-mask-image:radial-gradient(ellipse_90%_72%_at_50%_50%,black_28%,transparent_100%)] after:absolute after:inset-x-0 after:top-0 after:h-12 after:bg-linear-to-b after:from-theme-surface after:to-transparent after:content-[''] lg:inset-x-auto lg:right-0 lg:w-3/4 lg:mask-[radial-gradient(ellipse_75%_70%_at_65%_50%,black_35%,transparent_100%)] lg:[-webkit-mask-image:radial-gradient(ellipse_75%_70%_at_65%_50%,black_35%,transparent_100%)] mt-10"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 grid grid-cols-1 gap-y-12 lg:grid-cols-12 lg:gap-x-16 lg:gap-y-20"
  >
    <header class="col-span-1 lg:col-span-7">
      <p
        class="mb-4 font-body text-xs font-light tracking-[4px] text-theme-accent"
      >
        JOYERÍA
      </p>
      <h2
        id="jewelry-title"
        class="m-0 max-w-3xl font-display text-[34px] font-medium leading-[1.08] tracking-tight text-theme-foreground lg:text-5xl"
      >
        Encuentra una pieza que se vuelva parte de tu historia
      </h2>
    </header>

    <div class="col-span-1 pt-0 lg:col-span-5 lg:pt-8">
      <p
        class="m-0 max-w-xl font-body text-base font-normal leading-[1.6] text-theme-muted lg:text-lg"
      >
        Explora nuestro aparador de piezas importadas, nacionales e italianas en
        oro y plata. Diseños disponibles para llevar, elegir con calma y
        acompañar tanto lo cotidiano como las ocasiones que merecen recordarse.
      </p>
      <p
        class="m-0 mt-6 font-body text-xs font-light leading-5 tracking-[4px] text-theme-accent"
      >
        ORO Y PLATA · PIEZAS PARA USO DIARIO Y OCASIONES ESPECIALES
      </p>
    </div>

    <div
      class="col-span-1 grid grid-cols-[minmax(0,1.16fr)_minmax(0,0.78fr)] grid-rows-[auto_auto] items-start gap-x-3 gap-y-6 lg:col-span-12 lg:grid-cols-12 lg:grid-rows-none lg:gap-x-16"
    >
      <figure
        class="col-start-1 row-span-2 row-start-1 m-0 aspect-2/3 overflow-hidden lg:col-span-7 lg:row-span-1"
      >
        <Image
          src={jewelryChainMain}
          alt="Cadena dorada dispuesta sobre un fondo oscuro en una composición de joyería."
          width={736}
          height={1104}
          densities={[1, 2]}
          quality={82}
          fit="cover"
          position="center"
          class="h-full w-full object-cover object-center"
        />
      </figure>

      <div
        class="contents lg:col-start-8 lg:col-span-5 lg:row-start-1 lg:grid lg:gap-y-10"
      >
        <div
          class="col-start-2 row-start-1 -ml-8 min-w-0 lg:col-auto lg:row-auto lg:ml-0"
        >
          <figure class="m-0 aspect-3/2 w-full overflow-hidden">
            <Image
              src={jewelryProducts}
              alt="Selección de joyas doradas presentada en un aparador."
              width={560}
              height={374}
              densities={[1, 2]}
              quality={82}
              fit="cover"
              position="center"
              class="h-full w-full object-cover object-center"
            />
          </figure>
          <span class="mt-4 block h-px w-45 bg-theme-accent" aria-hidden="true"
          ></span>
        </div>
        <figure
          class="col-start-2 row-start-2 -mt-8 m-0 aspect-square w-[86%] justify-self-end overflow-hidden lg:col-auto lg:row-auto lg:mt-0 lg:w-3/4"
        >
          <Image
            src={jewelryModel}
            alt="Persona luciendo una cadena dorada sobre una camisa blanca."
            width={360}
            height={360}
            densities={[1, 2]}
            quality={85}
            fit="cover"
            position="center"
            class="h-full w-full object-cover object-center"
          />
        </figure>
      </div>
    </div>
  </div>
</SectionContainer>
