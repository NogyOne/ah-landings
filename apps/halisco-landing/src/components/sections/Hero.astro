---
import { Image } from "astro:assets";
import heroImage from "@assets/images/hero-bride.webp";
import Button from "@ui/Button.astro";
---

<section
  class="relative h-screen overflow-hidden bg-theme-background"
  id="hero"
  aria-labelledby="hero-title"
>
  <div class="absolute inset-0 h-full w-full" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      width={1440}
      height={960}
      densities={[1, 2]}
      quality={80}
      fit="cover"
      position="center"
      priority
      class="max-w-none h-full w-full object-cover object-center"
    />
    <div
      class="absolute inset-0 bg-linear-to-r from-theme-background/95 via-theme-background/60 to-transparent w-1/3"
    >
    </div>
    <div
      class="absolute bottom-0 left-0 right-0 bg-linear-to-t from-theme-surface via-theme-surface/65 to-transparent h-1/3"
    >
    </div>
  </div>

  <div class="absolute left-60 top-80 z-1 w-130">
    <p
      class="mb-3 font-light font-body text-xs tracking-[4px] text-theme-accent"
    >
      DESDE 1985
    </p>
    <h1
      class="m-0 max-w-155 font-display text-6xl font-medium leading-[0.94] tracking-tight text-theme-foreground"
      id="hero-title"
    >
      <span class="block">El oro guarda</span>
      <span class="block text-theme-accent">lo que se promete</span>
    </h1>
    <p
      class="m-0 mt-10 max-w-full font-body text-base font-normal text-theme-muted"
    >
      Joyería en oro y plata, hechuras propias y reparaciones que devuelven vida
      a tus piezas.
    </p>
    <div class="mt-10 flex items-center gap-4">
      <Button label="VISITAR LA JOYERÍA" href="#visit" />
      <Button
        label="COTIZAR POR WHATSAPP"
        href="#whatsapp"
        variant="secondary"
      />
    </div>
  </div>

  <!-- Temporary internal targets keep this first slice honest until later chapters are implemented. -->
  <div
    class="absolute h-px w-px overflow-hidden [clip-path:inset(50%)]"
    aria-hidden="true"
  >
    <span id="hechuras"></span>
    <span id="repairs"></span>
    <span id="watchmaking"></span>
    <span id="questions"></span>
    <span id="visit"></span>
    <span id="whatsapp"></span>
  </div>
</section>
