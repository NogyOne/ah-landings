---
import { Image } from "astro:assets";
import heroImage from "@assets/images/hero/hero-bride.webp";
import Button from "@ui/Button.astro";
---

<section
  class="relative h-screen min-h-170 overflow-hidden bg-theme-background md:h-screen md:min-h-0"
  id="hero"
  aria-labelledby="hero-title"
>
  <div class="absolute inset-0 h-full w-full" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      width={1440}
      height={960}
      densities={[1, 2]}
      quality={80}
      fit="cover"
      position="center"
      priority
      class="max-w-none h-full w-full object-cover object-[75%_center] md:object-center"
    />
    <div
      class="absolute inset-0 h-full w-1/3 bg-linear-to-r from-theme-background/95 via-theme-background/60 to-transparent"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-2/3 bg-linear-to-t from-theme-surface via-theme-surface/65 to-transparent md:h-1/3"
    >
    </div>
  </div>

  <div
    class="absolute inset-x-0 bottom-30 z-10 w-full px-5 pb-12 md:left-30 md:top-80 lg:left-60 lg:top-80 lg:bottom-auto lg:inset-x-auto lg:z-1 lg:w-130 lg:px-0 md:pb-0"
  >
    <p
      class="mb-3 font-light font-body text-xs tracking-[4px] text-theme-accent"
    >
      DESDE 1985
    </p>
    <h1
      class="m-0 max-w-155 font-display text-[38px] font-medium leading-[0.96] tracking-tight text-theme-foreground md:text-6xl md:leading-[0.94]"
      id="hero-title"
    >
      <span class="block">El oro guarda</span>
      <span class="block text-theme-accent">lo que se promete</span>
    </h1>
    <p
      class="m-0 mt-6 max-w-[350px] font-body text-base font-normal text-theme-muted md:mt-10 lg:max-w-full"
    >
      Joyería en oro y plata, hechuras propias y reparaciones que devuelven vida
      a tus piezas.
    </p>
    <div
      class="mt-8 flex w-full max-w-[350px] items-center gap-3 md:mt-10 md:w-auto md:max-w-none md:gap-4"
    >
      <Button
        class="min-w-0 flex-1 px-2 text-[10px] md:flex-none md:px-5 md:text-xs"
        label="VISITAR LA JOYERÍA"
        href="#visit"
      />
      <Button
        class="min-w-0 flex-1 px-2 text-[10px] md:flex-none md:px-5 md:text-xs"
        label="COTIZAR POR WHATSAPP"
        href="#whatsapp"
        variant="secondary"
      />
    </div>
  </div>

  <!-- Mobile navigation and future motion hooks live outside this section. -->

  <!-- Temporary internal targets keep this first slice honest until later chapters are implemented. -->
  <div
    class="absolute h-px w-px overflow-hidden [clip-path:inset(50%)]"
    aria-hidden="true"
  >
    <span id="watchmaking"></span>
    <span id="questions"></span>
    <span id="visit"></span>
    <span id="whatsapp"></span>
  </div>
</section>
