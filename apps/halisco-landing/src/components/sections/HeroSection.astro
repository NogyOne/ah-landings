---
import { Image } from "astro:assets";
import heroImage from "@assets/images/hero/hero-bride.webp";
import Button from "@ui/Button.astro";
---

<section
  class="relative h-screen min-h-170 overflow-hidden bg-theme-background md:h-screen md:min-h-0"
  id="hero"
  aria-labelledby="hero-title"
  data-hero-root
>
  <div class="absolute inset-0 h-full w-full" aria-hidden="true">
    <Image
      src={heroImage}
      alt=""
      width={1920}
      height={1080}
      densities={[1, 2]}
      quality={80}
      fit="cover"
      position="center"
      priority
      class="max-w-none h-full w-full object-cover object-[75%_center] md:object-center"
      data-hero-media
    />
    <div
      class="absolute inset-0 h-full w-1/3 bg-linear-to-r from-theme-background/95 via-theme-background/60 to-transparent"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-2/3 bg-linear-to-t from-theme-surface via-theme-surface/65 to-transparent md:h-1/3"
    >
    </div>
  </div>

  <div
    class="absolute inset-x-0 bottom-30 z-10 w-full px-5 pb-12 md:left-30 md:top-80 lg:left-60 lg:top-80 lg:bottom-auto lg:inset-x-auto lg:z-1 lg:w-130 lg:px-0 md:pb-0"
  >
    <p
      class="mb-3 font-light font-body text-xs tracking-[4px] text-theme-accent"
      data-hero-eyebrow
    >
      DESDE 1985
    </p>
    <h1
      class="m-0 max-w-155 font-display text-[38px] font-medium leading-[0.96] tracking-tight text-theme-foreground md:text-6xl md:leading-[0.94]"
      id="hero-title"
    >
      <span class="block" data-hero-heading-line
        ><span class="inline-block" data-hero-word>El</span>{" "}<span
          class="inline-block"
          data-hero-word>oro</span
        >{" "}<span class="inline-block" data-hero-word>guarda</span></span
      >{" "}<span class="block text-theme-accent" data-hero-heading-line
        ><span class="inline-block" data-hero-word>lo</span>{" "}<span
          class="inline-block"
          data-hero-word>que</span
        >{" "}<span class="inline-block" data-hero-word>se</span>{" "}<span
          class="inline-block"
          data-hero-word>promete</span
        ></span
      >
    </h1>
    <p
      class="m-0 mt-6 max-w-[350px] font-body text-base font-normal text-theme-muted md:mt-10 lg:max-w-full"
      data-hero-lead
    >
      Joyería en oro y plata, hechuras propias y reparaciones que devuelven vida
      a tus piezas.
    </p>
    <div
      class="mt-8 flex w-full max-w-[350px] items-center gap-3 md:mt-10 md:w-auto md:max-w-none md:gap-4"
      data-hero-cta
    >
      <Button
        class="min-w-0 flex-1 px-2 text-[10px] md:flex-none md:px-5 md:text-xs"
        label="VISITAR LA JOYERÍA"
        href="#visit"
      />
      <Button
        class="min-w-0 flex-1 px-2 text-[10px] md:flex-none md:px-5 md:text-xs"
        label="COTIZAR POR WHATSAPP"
        href="https://wa.me/526871908152"
        variant="secondary"
      />
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  const ROOT_SELECTOR = "[data-hero-root]";

  const initHeroEntrance = (): void => {
    document.querySelectorAll<HTMLElement>(ROOT_SELECTOR).forEach((root) => {
      if (root.dataset.heroInitialized === "true") {
        return;
      }

      const media = root.querySelector<HTMLElement>("[data-hero-media]");
      const eyebrow = root.querySelector<HTMLElement>("[data-hero-eyebrow]");
      const words = root.querySelectorAll<HTMLElement>("[data-hero-word]");
      const lead = root.querySelector<HTMLElement>("[data-hero-lead]");
      const cta = root.querySelector<HTMLElement>("[data-hero-cta]");

      if (!media || !eyebrow || words.length === 0 || !lead || !cta) {
        return;
      }

      root.dataset.heroInitialized = "true";

      const mm = gsap.matchMedia();
      let timeline: gsap.core.Timeline | null = null;

      mm.add(
        {
          reduceMotion: "(prefers-reduced-motion: reduce)",
          fullMotion: "(prefers-reduced-motion: no-preference)",
        },
        (context) => {
          const reduceMotion = context.conditions?.reduceMotion === true;

          timeline = gsap.timeline({ defaults: { ease: "power3.out" } });

          if (reduceMotion) {
            timeline.fromTo(
              [media, eyebrow, ...words, lead, cta],
              { autoAlpha: 0 },
              { autoAlpha: 1, duration: 0.24, ease: "power1.out" },
            );
          } else {
            timeline
              .fromTo(
                media,
                { scale: 1.04, autoAlpha: 0.92 },
                { scale: 1, autoAlpha: 1, duration: 1.6 },
                0,
              )
              .addLabel("contentIn", 0.4)
              .fromTo(
                eyebrow,
                { autoAlpha: 0, y: 6 },
                { autoAlpha: 1, y: 0, duration: 0.5 },
                "contentIn",
              )
              .addLabel("titleIn", "contentIn+=0.2")
              .fromTo(
                words,
                {
                  autoAlpha: 0,
                  y: 8,
                  scale: 0.99,
                  rotationX: 5,
                  transformPerspective: 400,
                  transformOrigin: "50% 100%",
                },
                {
                  autoAlpha: 1,
                  y: 0,
                  scale: 1,
                  rotationX: 0,
                  duration: 0.65,
                  stagger: 0.055,
                },
                "titleIn",
              )
              .addLabel("leadIn", "titleIn+=0.45")
              .fromTo(
                lead,
                { autoAlpha: 0, y: 4 },
                { autoAlpha: 1, y: 0, duration: 0.55 },
                "leadIn",
              )
              .addLabel("ctaIn", "leadIn+=0.2")
              .fromTo(
                cta,
                { autoAlpha: 0, scale: 0.98 },
                { autoAlpha: 1, scale: 1, duration: 0.5 },
                "ctaIn",
              );
          }

          return () => {
            timeline?.revert();
            timeline = null;
          };
        },
      );

      const cleanup = (): void => {
        mm.revert();
        document.removeEventListener("astro:before-swap", cleanup);
        root.dataset.heroInitialized = "false";
      };

      document.addEventListener("astro:before-swap", cleanup, { once: true });
    });
  };

  initHeroEntrance();
</script>
